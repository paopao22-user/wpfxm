{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],

        //MinimumLevel:从哪个日志级别开始记录
        "MinimumLevel": {
            "Default": "Information",

            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        },

        //同一条日志，一份显示控制台，一份保存文件
        "WriteTo": [
            {
                "Name": "Console"
            },

            {
                "Name": "File",
                "Args": {
                    "path": "logs/iot-gateway-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14
                }
            }
        ],

        //允许 Serilog 把当前请求上下文中的附加信息一起带进日志
        "Enrich": [
            "FromLogContext"
        ]

    },



    "ConnectionStrings": {
        "Default": "Server=108.174.50.133;Port=3306;DataBase=iot_gateway;User=iot_user;Password=Iot@2024;TreatTinyAsBoolean=true;AllowUserVariables=true;"
    },

    "Jwt": {
        //服务器给 JWT 盖章时使用的秘密印章
        "Key": "IotGatewayLearning-Development-Key-2026-Change-Me", //JWT签名用的秘密钥匙
        "Issuer": "IotGatewayLearningApi", //谁签发这个Token
        "Audience": "WpfIotLearningPrism" //这个Token准备给谁使用

    },

    "AllowedHosts": "*"
}
